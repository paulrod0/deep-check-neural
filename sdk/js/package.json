{
  "name": "@deep-check/sdk",
  "version": "1.0.0",
  "description": "Deep-Check AI verification SDK — deepfake detection, document forensics, keystroke biometrics",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": ["deepfake", "detection", "document", "verification", "biometrics", "AI", "forensics", "identity"],
  "author": "Pablo Lopez Rodriguez <pablo@hiumsolutions.com>",
  "license": "BSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulrod0/deep-check"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
