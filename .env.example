# ─────────────────────────────────────────────────────────────────
# Deep-Check · Environment Variables
# Copy this file to .env.local and fill in real values for local dev.
# In production, set these in the Vercel dashboard (never commit secrets).
# ─────────────────────────────────────────────────────────────────

# ── InsForge (primary backend) ───────────────────────────────────
# Project URL (safe to expose in browser)
NEXT_PUBLIC_INSFORGE_URL=https://c96ph26y.eu-central.insforge.app

# Anon/public key — used for client-side queries
NEXT_PUBLIC_INSFORGE_ANON_KEY=ins_...

# Service key — server-side only (admin access)
# NEVER expose in client-side code or NEXT_PUBLIC_ variables
INSFORGE_SERVICE_KEY=ins_...

# ── Supabase (legacy fallback, remove after full migration) ──────
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Admin authentication ──────────────────────────────────────────
# Dashboard login password. Required — server returns 503 if missing.
# Generate with: openssl rand -base64 32
ADMIN_PASSWORD=change-me-generate-a-strong-password

# ── AWS Lambda LSTM inference ─────────────────────────────────────
# API Gateway endpoint for BiLSTM inference (optional).
# If not set, the system falls back to local ONNX (if available) or
# runs only XGBoost + IsoForest ensemble.
LSTM_LAMBDA_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/

# Bearer token that protects the Lambda endpoint.
# Required when LSTM_LAMBDA_URL is set.
# Generated by infra/deploy.sh — shown once after deployment.
LSTM_LAMBDA_SECRET=

# ── ML worker backends (server-side proxies) ─────────────────────
# Base URLs of the inference workers the API routes proxy to. Fail-closed:
# the routes return 503 if the relevant URL is not set (no hardcoded IPs in
# source). Identity documents / biometric images transit these — USE HTTPS
# or a private/encrypted network (e.g. Tailscale 100.x). Send the worker
# API key as X-API-Key via ML_WORKER_API_KEY (see ml-worker section).
# Previous hardcoded values (for reference — move behind HTTPS):
#   XEON_ML_URL  was http://100.116.188.12:8001   (Tailscale, encrypted)
#   AWS_GEMMA_URL was http://54.229.204.211:8002   (PUBLIC IP — plaintext!)
#   V8_API_URL   was http://52.215.31.248:8080     (PUBLIC IP — plaintext!)
XEON_ML_URL=
AWS_GEMMA_URL=
V8_API_URL=
V8_API_KEY=
# Sent as X-API-Key to the ML worker (verify-identity / verify-proxy).
ML_WORKER_API_KEY=
