# ─────────────────────────────────────────────────────────────────
# Deep-Check · Environment Variables
# Copy this file to .env.local and fill in real values for local dev.
# In production, set these in the Vercel dashboard (never commit secrets).
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
# Project URL (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Anon/public key — used for client-side queries with RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — server-side only (admin access, bypasses RLS)
# NEVER expose in client-side code or NEXT_PUBLIC_ variables
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Admin authentication ──────────────────────────────────────────
# Dashboard login password. Required — server returns 503 if missing.
# Generate with: openssl rand -base64 32
ADMIN_PASSWORD=change-me-generate-a-strong-password

# ── AWS Lambda LSTM inference ─────────────────────────────────────
# API Gateway endpoint for BiLSTM inference (optional).
# If not set, the system falls back to local ONNX (if available) or
# runs only XGBoost + IsoForest ensemble.
LSTM_LAMBDA_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/

# Bearer token that protects the Lambda endpoint.
# Required when LSTM_LAMBDA_URL is set.
# Generated by infra/deploy.sh — shown once after deployment.
LSTM_LAMBDA_SECRET=
