{
$adminKeys = "C:\ProgramData\ssh\administrators_authorized_keys"
$myKey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN/s0D9+xztp+QUcpYskyeTz9S2SnjMJ35OvqDOQwJGw hium@Pablos-MacBook-Pro.local"

Write-Host "=== PASO 1: tomar ownership y limpiar permisos ===" -ForegroundColor Cyan
takeown /f $adminKeys 2>&1 | Out-Host
icacls $adminKeys /reset 2>&1 | Out-Host

Write-Host "`n=== PASO 2: escribir fichero con ASCII puro (sin BOM) ===" -ForegroundColor Cyan
[System.IO.File]::WriteAllText($adminKeys, $myKey + "`n", [System.Text.Encoding]::ASCII)
Write-Host "Escrito."

Write-Host "`n=== PASO 3: ver bytes iniciales (NO debe empezar por 239,187,191 = BOM) ===" -ForegroundColor Cyan
$bytes = [System.IO.File]::ReadAllBytes($adminKeys)
Write-Host "Primeros 5 bytes: $($bytes[0..4] -join ',')"
Write-Host "Tamaño total: $($bytes.Length) bytes"

Write-Host "`n=== PASO 4: aplicar permisos correctos (solo Admins y SYSTEM) ===" -ForegroundColor Cyan
icacls $adminKeys /inheritance:r 2>&1 | Out-Host
icacls $adminKeys /grant:r "Administrators:(F)" 2>&1 | Out-Host
icacls $adminKeys /grant:r "SYSTEM:(F)" 2>&1 | Out-Host

Write-Host "`n=== PASO 5: permisos finales ===" -ForegroundColor Cyan
icacls $adminKeys

Write-Host "`n=== PASO 6: contenido final ===" -ForegroundColor Cyan
Get-Content $adminKeys

Write-Host "`n=== PASO 7: reiniciar sshd ===" -ForegroundColor Cyan
Restart-Service sshd
Get-Service sshd | Format-Table

Write-Host "`n=== PASO 8: log SSH (últimos 5 eventos) ===" -ForegroundColor Cyan
Get-WinEvent -ProviderName 'OpenSSH' -MaxEvents 5 -ErrorAction SilentlyContinue | Format-Table TimeCreated, LevelDisplayName, Message -Wrap

Write-Host "`n✅ DONE. Pega TODA esta salida." -ForegroundColor Green
  
