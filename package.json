{
# 1. Mi clave pública
$myKey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN/s0D9+xztp+QUcpYskyeTz9S2SnjMJ35OvqDOQwJGw hium@Pablos-MacBook-Pro.local"

# 2. Fichero correcto para administradores en Windows 11
$adminKeys = "$env:ProgramData\ssh\administrators_authorized_keys"

# 3. Crear si no existe + añadir mi clave (sin duplicar)
if (-not (Test-Path $adminKeys)) { New-Item -ItemType File -Force -Path $adminKeys | Out-Null }
$current = Get-Content $adminKeys -ErrorAction SilentlyContinue
if ($current -notcontains $myKey) {
    Add-Content -Path $adminKeys -Value $myKey
    Write-Host "✅ Clave añadida"
} else {
    Write-Host "ℹ️ Clave ya estaba"
}

# 4. Permisos OBLIGATORIOS (Windows OpenSSH es muy estricto con esto)
icacls $adminKeys /inheritance:r
icacls $adminKeys /grant "Administrators:F"
icacls $adminKeys /grant "SYSTEM:F"

# 5. Reiniciar SSHd para que recargue
Restart-Service sshd

# 6. Mostrar contenido para verificar
Write-Host "`n=== Contenido de administrators_authorized_keys ==="
Get-Content $adminKeys

Write-Host "`n=== Estado sshd ==="
Get-Service sshd | Format-List Name, Status
  
